# --- Acceso ---
# Clave publishable del proyecto (Dashboard > Settings > API Keys). Es la que va en el header `apikey`.
PUBLISHABLE_KEY=
# true = no pide apikey ni token. SOLO para probar en local; nunca en producción.
CHATBOT_AUTH_DISABLED=false
CORS_ORIGINS=*

# --- Modelos de lenguaje (todos con plan gratuito) ---
# Orden en que se prueban; el que no tiene clave se saltea. Si ninguno responde, usa reglas.
CHATBOT_LLM_PROVIDERS=gemini,groq,nvidia
GEMINI_API_KEY=
# Nombre exacto del modelo en Google AI Studio (por ejemplo gemini-3.5-flash-lite).
GEMINI_MODEL=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
NVIDIA_API_KEY=
NVIDIA_MODEL=openai/gpt-oss-120b
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# false = nunca usa modelos, solo reglas y la base de conocimiento.
CHATBOT_USE_LLM=true
CHATBOT_LLM_TIMEOUT_SECONDS=12
CHATBOT_PROVIDER_COOLDOWN_SECONDS=90

# --- Servicio ---
# false = apaga el servicio: GET y POST responden 503.
CHATBOT_AVAILABLE=true
# Consultas por minuto de cada consumidor.
CHATBOT_RATE_LIMIT=20
CONVERSATION_TTL_MINUTES=30
CONVERSATION_MAX_TURNS=6
CHATBOT_CACHE_TTL_MINUTES=60
CHATBOT_CACHE_MAX_ENTRIES=500
CHATBOT_PROMPT_MAX_DOCUMENTS=12
CHATBOT_PROMPT_TOP_DOCUMENTS=3
