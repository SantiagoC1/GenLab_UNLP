# Copiar a .env (cp .env.example .env). Nunca subir .env al repositorio.

# --- Base de datos y autenticación: Supabase (Project Settings > API) ---
# Completar solo en el .env propio. La service role key da acceso total: va únicamente en el
# backend, nunca en el frontend ni en el repositorio.
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Backend ---
# Firma las sesiones. Mínimo 32 caracteres, distinta en cada entorno. Para generarla:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
SESSION_EXPIRE_MINUTES=30
CORS_ORIGINS=http://localhost:5173

# SOLO DESARROLLO. Con true, el backend acepta el encabezado X-Dev-Role (y X-Dev-User, opcional)
# en lugar del login y carga datos de demostración en memoria: el selector "DEV" del frontend lo
# manda en cada pedido. Sin definir o en false queda apagado. Nunca activarlo en un entorno real.
DEV_AUTH=false

# Integraciones externas: simulador | real
INTEGRACION_FAMILIOGRAMA=simulador
INTEGRACION_SNOMED=simulador
INTEGRACION_CUPONES=simulador
INTEGRACION_CDSS=simulador
INTEGRACION_APIGEN=simulador
INTEGRACION_OBRAS_SOCIALES=simulador
INTEGRACION_AVISOS=simulador
INTEGRACION_OPTIMIZACION_RECORRIDO=simulador
INTEGRACION_FEDEX=simulador
INTEGRACION_MINISTERIO_SALUD=simulador
CHATBOT_INTEGRATION=simulador

# El chatbot corre como Edge Function en Supabase. Con CHATBOT_INTEGRATION=real el backend le
# reenvía las consultas del paciente. Los tres datos son secretos del servidor: nunca van al
# frontend. La URL y la clave publishable salen del proyecto; el token lo emite quien administra el
# chatbot con: select public.chatbot_issue_token('plataforma');  (docs/Chatbot_Guia_implementacion.md)
CHATBOT_URL=https://<ref>.supabase.co/functions/v1/chat
CHATBOT_APIKEY=
CHATBOT_TOKEN=
# Las claves de los proveedores de IA (Gemini, etc.) no van acá: son secretos de la Edge Function
# (supabase secrets set --env-file supabase/functions/chat/.env).

# --- Frontend ---
VITE_API_URL=http://localhost:8000
