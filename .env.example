# Copiar a .env (cp .env.example .env). Nunca subir .env al repositorio.

# --- Base de datos ---
POSTGRES_USER=genlab
POSTGRES_PASSWORD=genlab
POSTGRES_DB=genlab

# --- Backend ---
DATABASE_URL=postgresql+psycopg://genlab:genlab@db:5432/genlab
SECRET_KEY=cambiar-en-cada-entorno
SESSION_EXPIRE_MINUTES=30
CORS_ORIGINS=http://localhost:5173
CHATBOT_URL=http://chatbot:8001

# Integraciones externas: simulador | real
INTEGRACION_FAMILIOGRAMA=simulador
INTEGRACION_SNOMED=simulador
INTEGRACION_CUPONES=simulador
INTEGRACION_CDSS=simulador
INTEGRACION_APIGEN=simulador
INTEGRACION_OBRAS_SOCIALES=simulador
INTEGRACION_AVISOS=simulador
INTEGRACION_OPTIMIZACION_RECORRIDO=simulador
INTEGRACION_FEDEX=simulador
INTEGRACION_MINISTERIO_SALUD=simulador

# --- Chatbot ---
# La clave de la API de Anthropic va solo por variable de entorno.
ANTHROPIC_API_KEY=
CHATBOT_DISPONIBLE=true

# --- Frontend ---
VITE_API_URL=http://localhost:8000
VITE_CHATBOT_URL=http://localhost:8001
