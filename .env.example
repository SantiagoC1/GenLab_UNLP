# Copiar a .env (cp .env.example .env). Nunca subir .env al repositorio.

# --- Base de datos y autenticación: Supabase (Project Settings > API) ---
# Completar solo en el .env propio. La service role key da acceso total: va únicamente en el
# backend, nunca en el frontend ni en el repositorio.
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Backend ---
# Firma las sesiones. Mínimo 32 caracteres, distinta en cada entorno. Para generarla:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
SESSION_EXPIRE_MINUTES=30
CORS_ORIGINS=http://localhost:5173
CHATBOT_URL=http://chatbot:8001

# Integraciones externas: simulador | real
INTEGRACION_FAMILIOGRAMA=simulador
INTEGRACION_SNOMED=simulador
INTEGRACION_CUPONES=simulador
INTEGRACION_CDSS=simulador
INTEGRACION_APIGEN=simulador
INTEGRACION_OBRAS_SOCIALES=simulador
INTEGRACION_AVISOS=simulador
INTEGRACION_OPTIMIZACION_RECORRIDO=simulador
INTEGRACION_FEDEX=simulador
INTEGRACION_MINISTERIO_SALUD=simulador

# --- Chatbot ---
# Las claves de los proveedores de IA van solo por variable de entorno. Todos tienen plan gratuito.
# Orden en que se prueban; el que no tiene clave se saltea. Si ninguno responde, usa reglas.
CHATBOT_LLM_PROVIDERS=gemini,groq,nvidia
# Gemini (Google AI Studio). Modelo: por ejemplo gemini-2.5-flash; confirmar el nombre vigente.
GEMINI_API_KEY=
GEMINI_MODEL=
# Groq (console.groq.com). Ya trae el modelo por defecto openai/gpt-oss-120b.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# NVIDIA NIM (build.nvidia.com). Ya trae el modelo por defecto openai/gpt-oss-120b.
NVIDIA_API_KEY=
NVIDIA_MODEL=openai/gpt-oss-120b
# OpenRouter (opcional). Hay que elegir un modelo gratuito vigente, sin default.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# false = nunca usa modelos, solo reglas y la base de conocimiento.
CHATBOT_USE_LLM=true
# Segundos de espera por proveedor, y cuánto se lo saltea después de agotar su cuota o caerse.
CHATBOT_LLM_TIMEOUT_SECONDS=12
CHATBOT_PROVIDER_COOLDOWN_SECONDS=90
# false = apaga el servicio: /health y /chat responden 503.
CHATBOT_AVAILABLE=true
# Claves de los consumidores ("nombre:clave,nombre:clave"). Vacío = no pide clave (solo desarrollo).
CHATBOT_API_KEYS=
# Consultas por minuto de cada consumidor.
CHATBOT_RATE_LIMIT=20

# --- Frontend ---
VITE_API_URL=http://localhost:8000
VITE_CHATBOT_URL=http://localhost:8001
